{
  "permissions": {
    "allow": [
      "mcp__claude-in-chrome__find",
      "mcp__claude-in-chrome__get_page_text",
      "mcp__claude-in-chrome__tabs_context_mcp"
    ]
  },
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 .claude/hooks/typewriter-reminder.py"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Agent|TodoWrite|Edit|Write|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "python3 .claude/hooks/typewriter-gate.py"
          }
        ]
      }
    ]
  }
}
