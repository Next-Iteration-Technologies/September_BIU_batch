{
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 .claude/hooks/typewriter-reminder.py"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Agent|TodoWrite|Edit|Write|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "python3 .claude/hooks/typewriter-gate.py"
          }
        ]
      }
    ]
  }
}
